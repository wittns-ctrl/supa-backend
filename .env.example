# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/supameal

# JWT secrets (use strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH=your_jwt_refresh_secret_here

# Server port
PORT=3000

# Frontend URL (used for OAuth redirects + password-reset emails)
FRONTEND_URL=http://localhost:5173

# SMTP email configuration (for OTP, password reset, contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
SUPPORT_EMAIL=support@supameal.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple Sign In (optional — button shows a clear error until configured)
APPLE_CLIENT_ID=com.example.supameal.web
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback
