# Server port
PORT=3000

# Node environment (development | production). Production refuses to boot
# without the required secrets below.
NODE_ENV=development

# MongoDB connection string (REQUIRED in production)
MONGO_URI=mongodb://localhost:27017/supameal
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2

# JWT secrets — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Dev fallbacks exist for local convenience only.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-32chars
JWT_REFRESH=dev-only-insecure-refresh-secret-change-32ch

# Access token lifetime (short) and refresh token lifetime (long)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend URL (used for OAuth redirects + password-reset emails)
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (comma-separated list; REQUIRED in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Reverse proxy: how many hops / which addresses to trust for client IP
# (rate limiting correctness). 'loopback' default; false to disable.
TRUST_PROXY=loopback

# Rate limiting — requests per window per IP (ttl is in MILLISECONDS)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Demo fixture seeding — ONLY applies in non-production. Set to true to seed
# demo restaurants/accounts on an empty database.
SEED_DEMO_DATA=false
# One-time/optional bootstrap for the single database admin. The backend hashes
# the password before storing it; admin login is thereafter checked against DB.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# SMTP email configuration (for OTP, password reset, contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use a Gmail App Password (not the regular account password) for Gmail SMTP.
SMTP_USER=
SMTP_PASS=
# Use the authenticated SMTP address or a sender alias verified by the provider.
FROM_EMAIL=
SUPPORT_EMAIL=mugishawitness15@gmail.com

# Alternative free email provider (https://resend.com — 100 emails/day free)
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple Sign In (optional — button shows a clear error until configured)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# PayPal Checkout API credentials from a PayPal Developer Dashboard REST app.
# Use sandbox credentials during development; keep the secret on the backend only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

# Local image upload storage (served at /uploads)
UPLOAD_DIR=./uploads
